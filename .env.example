# Genesis DoD Validators — Local Credentials Template
# Copy this file to .env in the repository root and fill in your values.
# .env is ignored by Git (.gitignore) so your tokens are never committed.

JIRA_BASE_URL=https://genesissoftwareinnovations.atlassian.net
JIRA_EMAIL=your.name@company.com
JIRA_API_TOKEN=your_atlassian_api_token_here

# Optional if already configured in ~/.cursor/mcp.json (under smartbear)
ZEPHYR_API_TOKEN=your_zephyr_scale_api_token_here
ZEPHYR_BASE_URL=https://api.zephyrscale.smartbear.com/v2
